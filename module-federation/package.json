{
  "name": "module-federation",
  "workspaces": [
    "app1",
    "app2",
    "host",
    "module1"
  ],
  "scripts": {
    "start:host": "pnpm --filter=host run start",
    "start:app1": "pnpm --filter=app1 run start",
    "start:app2": "pnpm --filter=app2 run start",
    "start:module1": "pnpm --filter=module1 run start",
    "start:standalone:app1": "pnpm --filter=app1 run start:standalone",
    "start:standalone:app2": "pnpm --filter=app2 run start:standalone",
    "start:standalone:module1": "pnpm --filter=module1 run start:standalone",
    "run:host:ios": "pnpm --filter=host run ios",
    "run:host:android": "pnpm --filter=host run android",
    "run:app1:ios": "pnpm --filter=app1 run ios",
    "run:app1:android": "pnpm --filter=app1 run android",
    "run:app2:ios": "pnpm --filter=app2 run ios",
    "run:app2:android": "pnpm --filter=app2 run android",
    "run:module1:ios": "pnpm --filter=module1 run ios",
    "run:module1:android": "pnpm --filter=module1 run android",
    "bootstrap:pods": "pnpm -r run pod_install",
    "bootstrap": "pnpm install && pnpm bootstrap:pods",
    "clean": "find ./ -type d -name 'node_modules' -exec rm -rf '{}' +",
    "start": "concurrently -P 'pnpm:start:*(!standalone) {1}'"
  },
  "devDependencies": {
    "concurrently": "^7.2.2"
  }
}
